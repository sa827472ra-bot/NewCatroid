<?xml version="1.0" encoding="utf-8"?>
<!--
  ~ Kix Engine Theme Colors
  ~ Dark Gray + Emerald Green Professional UI
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Kix Engine Primary Colors -->
    <color name="kix_dark_gray_900">#1A1A1A</color>
    <color name="kix_dark_gray_800">#2D2D2D</color>
    <color name="kix_dark_gray_700">#3F3F3F</color>
    <color name="kix_dark_gray_600">#505050</color>
    <color name="kix_dark_gray_500">#616161</color>
    
    <color name="kix_emerald_primary">#1ABC9C</color>
    <color name="kix_emerald_light">#2ECC71</color>
    <color name="kix_emerald_dark">#16A085</color>
    <color name="kix_emerald_accent">#27AE60</color>

    <!-- Kix Engine UI Colors -->
    <color name="kix_toolbar_background">@color/kix_dark_gray_900</color>
    <color name="kix_toolbar_icons">@color/kix_emerald_primary</color>
    
    <color name="kix_app_background">@color/kix_dark_gray_800</color>
