    <color name="kix_accent_light">@color/kix_emerald_light</color>
    <color name="kix_accent_dark">@color/kix_emerald_dark</color>
    
    <color name="kix_separator">#3F3F3F</color>
    <color name="kix_overlay">#B31A1A1A</color>

    <!-- Kix Engine Brick Colors -->
    <color name="kix_brick_camera">#1ABC9C</color>
    <color name="kix_brick_joystick">#2ECC71</color>
    <color name="kix_brick_network">#27AE60</color>
    <color name="kix_brick_collision">#16A085</color>
    <color name="kix_brick_bot">#1ABC9C</color>
